import os

def read_file(filepath):
    """
    Reads content from a text file.

    Args:
        filepath (str): The path to the file.

    Returns:
        str: The content of the file, or None if an error occurs.
    """
    try:
        with open(filepath, 'r', encoding='utf-8') as file:
            return file.read()
    except FileNotFoundError:
        print(f"Error: The file at '{filepath}' was not found. 😔")
        return None
    except IOError as e:
        print(f"Error: An I/O error occurred while reading the file. {e} 😞")
        return None

def write_file(filepath, content):
    """
    Writes content to a text file.

    Args:
        filepath (str): The path to the file.
        content (str): The content to write.

    Returns:
        bool: True if the write was successful, False otherwise.
    """
    try:
        with open(filepath, 'w', encoding='utf-8') as file:
            file.write(content)
        print("File updated successfully! 🎉")
        return True
    except IOError as e:
        print(f"Error: An I/O error occurred while writing to the file. {e} 😖")
        return False

def find_and_replace(filepath, old_word, new_word):
    """
    Finds and replaces all occurrences of a word in a file.

    Args:
        filepath (str): The path to the file.
        old_word (str): The word to find.
        new_word (str): The word to replace it with.
    """
    file_content = read_file(filepath)
    if file_content is None:
        return

    if old_word not in file_content:
        print(f"'{old_word}' was not found in the file. No changes made. 🧐")
        return

    modified_content = file_content.replace(old_word, new_word)
    
    if write_file(filepath, modified_content):
        print(f"Successfully replaced all occurrences of '{old_word}' with '{new_word}'.")

